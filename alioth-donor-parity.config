# Native and imported donor fragment implementations.
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OOPS=y
CONFIG_MTD_BLOCK2MTD=y
CONFIG_BACKLIGHT_KTZ8866=y
CONFIG_BACKLIGHT_DUALKTZ8866=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_PS5169=y
CONFIG_MOTOR_DRV8846=y
CONFIG_AIROHA_GPS=y
CONFIG_HALL_AKM09970=y
CONFIG_INPUT_XIAOMI_KEYBOARD=y
CONFIG_KEYBOARD_NANO_8030=y
CONFIG_LEDS_AW2015=y
CONFIG_FRAME_WARN=4096
CONFIG_SMB1390_CHARGE_PUMP_PSY=n
CONFIG_INPUT_QTI_HAPTICS=n
CONFIG_MSM_RDBG=y
CONFIG_QCOM_LLCC_PERFMON=y
CONFIG_MFD_I2C_PMIC=y
CONFIG_REGULATOR_PM8008=y
CONFIG_I2C_RETRY=y
CONFIG_TOUCHSCREEN_COMMON=y
CONFIG_ONEWIRE_GPIO=y
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_US_PROXIMITY=y

# Native ramoops DT reserves the donor 4 MiB; no private early_param needed.
CONFIG_CMDLINE="cgroup_disable=pressure"

# Match donor debugfs policy using native option names.
CONFIG_DEBUG_FS=n
CONFIG_CMA_DEBUGFS=n
CONFIG_REGMAP_QTI_DEBUGFS=n
CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE=n
CONFIG_ZSMALLOC_STAT=n

# These debugging features otherwise select DEBUG_FS back on.
CONFIG_PAGE_OWNER=n
CONFIG_PAGE_PINNER=n
