From 35d900a0abef9aca2430777eeed6e6fa80f40970 Mon Sep 17 00:00:00 2001
From: johnmart19 <johnivan19999@gmail.com>
Date: Sun, 11 Oct 2026 16:48:53 +0000
Subject: [PATCH] soc: qcom: Preserve Kona UEFI SPSS link and legacy CMAC ioctl

Create the donor SPSS transport at probe without reloading UEFI firmware. Reuse it on initial remoteproc start and tear it down on removal or SSR. Restore the actual three-app CMAC transfer for the legacy ioctl on Kona; keep new platforms unchanged. Use the native aoss_qmp phandle.
---
 .../qcom/sm8250-xiaomi-alioth-trustzone.dtsi  |  2 +-
 drivers/remoteproc/qcom_spss.c                | 22 ++++++++++++++--
 drivers/soc/qcom/spss_utils.c                 | 25 +++++++++++++++++++
 3 files changed, 46 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-alioth-trustzone.dtsi b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-alioth-trustzone.dtsi
index e1c2f15a8b3f..51719c6f3899 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-alioth-trustzone.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-alioth-trustzone.dtsi
@@ -86,7 +86,7 @@ alioth_spss: remoteproc@188101c {
   cx-uV-uA = <0 0>;
   mx-uV-uA = <0 0>;
   qcom,signal-aop;
-  qcom,qmp = <&aoss>;
+  qcom,qmp = <&aoss_qmp>;
   qcom,spss-scsr-bits = <24 25>;
   memory-region = <&spss_mem>;
   #address-cells = <2>;
diff --git a/drivers/remoteproc/qcom_spss.c b/drivers/remoteproc/qcom_spss.c
index ecc71fa52716..cbce9210a440 100644
--- a/drivers/remoteproc/qcom_spss.c
+++ b/drivers/remoteproc/qcom_spss.c
@@ -109,7 +109,15 @@ static int glink_spss_subdev_start(struct rproc_subdev *subdev)
 {
 	struct qcom_rproc_glink *glink = to_glink_subdev(subdev);
 
-	glink->edge = qcom_glink_spss_register(glink->dev, glink->node);
+	if (glink->edge)
+  return 0;
+ glink->edge = qcom_glink_spss_register(glink->dev, glink->node);
+ if (IS_ERR(glink->edge)) {
+  int ret = PTR_ERR(glink->edge);
+
+  glink->edge = NULL;
+  return ret;
+ }
 
 	return PTR_ERR_OR_ZERO(glink->edge);
 }
@@ -118,7 +126,8 @@ static void glink_spss_subdev_stop(struct rproc_subdev *subdev, bool crashed)
 {
 	struct qcom_rproc_glink *glink = to_glink_subdev(subdev);
 
-	qcom_glink_spss_unregister(glink->edge);
+	if (glink->edge)
+  qcom_glink_spss_unregister(glink->edge);
 	glink->edge = NULL;
 }
 
@@ -168,6 +177,7 @@ static void qcom_remove_glink_spss_subdev(struct rproc *rproc,
 	if (!glink->node)
 		return;
 
+	glink_spss_subdev_stop(&glink->subdev, false);
 	rproc_remove_subdev(rproc, &glink->subdev);
 	kfree_const(glink->ssr_name);
 	of_node_put(glink->node);
@@ -703,6 +713,14 @@ static int qcom_spss_probe(struct platform_device *pdev)
 		goto remove_subdev;
 	}
 
+	/* Kona UEFI has already loaded SPSS. Match the donor transport lifetime
+  * without guessing newer-SoC boot-state registers or reauthenticating it.
+  */
+ if (spss->kona) {
+  ret = glink_spss_subdev_start(&spss->glink_subdev.subdev);
+  if (ret)
+   goto remove_subdev;
+ }
 	ret = rproc_add(rproc);
 	if (ret)
 		goto remove_subdev;
diff --git a/drivers/soc/qcom/spss_utils.c b/drivers/soc/qcom/spss_utils.c
index a74af4791d65..ade9cfc246c5 100644
--- a/drivers/soc/qcom/spss_utils.c
+++ b/drivers/soc/qcom/spss_utils.c
@@ -561,6 +561,31 @@ static long spss_utils_ioctl(struct file *file,
 	}
 
 	switch (cmd) {
+ case SPSS_IOC_SET_FW_CMAC: {
+  const struct spss_ioc_set_fw_cmac *legacy = req;
+
+  if (!kona_spss || size != sizeof(*legacy))
+   return -EINVAL;
+  if (!cmac_mem) {
+   cmac_mem = ioremap(cmac_mem_addr, CMAC_MEM_SIZE);
+   if (!cmac_mem)
+    return -ENOMEM;
+  }
+  memset(saved_apps_cmac, 0, sizeof(saved_apps_cmac));
+  memcpy(saved_fw_cmac, legacy->cmac, sizeof(saved_fw_cmac));
+  memcpy(saved_apps_cmac, legacy->apps_cmac, sizeof(legacy->apps_cmac));
+  ret = spss_set_saved_fw_cmac(saved_fw_cmac, sizeof(saved_fw_cmac));
+  if (ret)
+   return ret;
+  ret = spss_set_saved_uefi_apps_cmac();
+  if (ret)
+   return ret;
+  is_iar_active = true;
+  spss_get_fw_calc_cmac();
+  spss_get_apps_calc_cmac();
+  break;
+ }
+
 	case SPSS_IOC_SET_FW_AND_APPS_CMAC:
 		pr_debug("ioctl [SPSS_IOC_SET_FW_AND_APPS_CMAC]\n");
 
-- 
2.53.0

