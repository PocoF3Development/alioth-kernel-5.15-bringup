+		return ret;
+	INIT_LIST_HEAD(&vpu->alg_regions);
+	INIT_LIST_HEAD(&vpu->ctl_list);
+	INIT_WORK(&vpu->boot_work, wm_vpu_boot_work);
+	mutex_init(&vpu->pwr_lock);
+	return 0;
+}
