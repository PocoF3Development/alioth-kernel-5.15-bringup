+	reg_write(tfa, 0x10, 0x0018); //POR=0x0024
+	reg_write(tfa, 0x22, 0x0003); //POR=0x0023
+	reg_write(tfa, 0x25, 0x0001); //POR=0x0000
+	reg_write(tfa, 0x46, 0x0000); //POR=0x4000
