+
+	misc_deregister(&tfa98xx->tfa98xx_reg);
+	misc_deregister(&tfa98xx->tfa98xx_rw);
+	misc_deregister(&tfa98xx->tfa98xx_rpc);
+	misc_deregister(&tfa98xx->tfa98xx_profile);
+	misc_deregister(&tfa98xx->tfa98xx_control);
+	return;
+}
