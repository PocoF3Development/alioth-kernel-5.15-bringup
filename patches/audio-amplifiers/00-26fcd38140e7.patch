+static int tfa98xx_ext_reset(struct tfa98xx *tfa98xx)
+{
+	if (tfa98xx && gpio_is_valid(tfa98xx->reset_gpio)) {
+		int reset = tfa98xx->reset_polarity;
+		gpio_set_value_cansleep(tfa98xx->reset_gpio, reset);
+		mdelay(10);
+		gpio_set_value_cansleep(tfa98xx->reset_gpio, !reset);
+		mdelay(10);
+	}
+	return 0;
+}
