 include/linux/leds-aw2015.h | 43 +++++++++++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)
 create mode 100644 include/linux/leds-aw2015.h

diff --git a/include/linux/leds-aw2015.h b/include/linux/leds-aw2015.h
new file mode 100644
index 000000000000..62e443697eea
--- /dev/null
+++ b/include/linux/leds-aw2015.h
@@ -0,0 +1,43 @@
