+	POWER_SUPPLY_PROP_CHARGING_ENABLED,
+	POWER_SUPPLY_PROP_STATUS,
+
+	POWER_SUPPLY_PROP_TI_BATTERY_PRESENT,
+	POWER_SUPPLY_PROP_TI_VBUS_PRESENT,
+	POWER_SUPPLY_PROP_TI_BATTERY_VOLTAGE,
+	POWER_SUPPLY_PROP_TI_BATTERY_CURRENT,
