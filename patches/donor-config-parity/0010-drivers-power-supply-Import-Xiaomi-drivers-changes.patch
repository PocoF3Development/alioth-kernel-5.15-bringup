+	bq->cfg->die_therm_disable =
+		of_property_read_bool(np, "ti,bq2597x,die-therm-disable");
+
+	ret = of_property_read_u32(np, "ti,bq2597x,bat-ovp-threshold",
+				   &bq->cfg->bat_ovp_th);
