+#define ERROR_R_STATUS -2
+#define ERROR_R_ROMID -3
+#define ERROR_R_PAGEDATA -4
+#define ERROR_COMPUTE_MAC -5
+#define ERROR_S_SECRET -6
+#define ERROR_UNMATCH_MAC -7
