From 2131a0c45808e4a688cc3f5c871e50fb3338604d Mon Sep 17 00:00:00 2001
From: johnmart19 <johnivan19999@gmail.com>
Date: Sun, 11 Oct 2026 18:54:32 +0000
Subject: [PATCH 25/27] alioth: Resolve optional donor panel and USB hooks at
 runtime

---
 .../misc/xiaomi_keyboard/xiaomi_keyboard.c    |  9 ++++++++-
 drivers/video/backlight/dualktz8866.c         | 19 +++++++++++++++++--
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/drivers/input/misc/xiaomi_keyboard/xiaomi_keyboard.c b/drivers/input/misc/xiaomi_keyboard/xiaomi_keyboard.c
index 8993a5ddfbfa..344ed51bebff 100644
--- a/drivers/input/misc/xiaomi_keyboard/xiaomi_keyboard.c
+++ b/drivers/input/misc/xiaomi_keyboard/xiaomi_keyboard.c
@@ -63,6 +63,7 @@ static ssize_t xiaomi_keyboard_conn_status_store(struct device *dev,
 						 const char *buf, size_t count)
 {
 	char *cmd;
+	void (*reset_host)(void);
 	cmd = kzalloc(count + 1, GFP_KERNEL);
 
 	if (!cmd) {
@@ -83,11 +84,17 @@ static ssize_t xiaomi_keyboard_conn_status_store(struct device *dev,
 		MI_KB_INFO("disable keyboard\n");
 		set_keyboard_status(0);
 	} else if (!strncmp(cmd, "host_reset", 10)) {
+		reset_host = symbol_get(usb_reset_host);
+		if (!reset_host) {
+			kfree(cmd);
+			return -EOPNOTSUPP;
+		}
 		MI_KB_ERR("Reset Host!");
 		gpio_direction_output(mdata->pdata->rst_gpio, 0);
 		MI_KB_ERR("Pull Down RST GPIO");
 		msleep(100);
-		usb_reset_host();
+		reset_host();
+		symbol_put(usb_reset_host);
 		ssleep(3);
 		MI_KB_ERR("Pull Up RST GPIO");
 		gpio_direction_output(mdata->pdata->rst_gpio, 1);
diff --git a/drivers/video/backlight/dualktz8866.c b/drivers/video/backlight/dualktz8866.c
index cb7fdab391e3..6f3387afce1f 100644
--- a/drivers/video/backlight/dualktz8866.c
+++ b/drivers/video/backlight/dualktz8866.c
@@ -54,6 +54,19 @@ static struct ktz8866_led g_ktz8866_led;
 
 extern int mi_mipi_dsi_dcs_set_pwm_value(u16 dbv_value);
 
+static int ktz8866_set_panel_pwm(u16 value)
+{
+	int (*set_pwm)(u16);
+	int ret;
+
+	set_pwm = symbol_get(mi_mipi_dsi_dcs_set_pwm_value);
+	if (!set_pwm)
+		return -EOPNOTSUPP;
+	ret = set_pwm(value);
+	symbol_put(mi_mipi_dsi_dcs_set_pwm_value);
+	return ret;
+}
+
 static int ktz8866_read(u8 reg, u8 *data)
 {
 	int ret;
@@ -109,7 +122,8 @@ static int ktz8866_case1_test(int pwm, char *result)
 	u16 pwm_digital_value_b;
 
 	bl = pwm_to_51(pwm);
-	mi_mipi_dsi_dcs_set_pwm_value(bl);
+	if (ktz8866_set_panel_pwm(bl))
+		return -EOPNOTSUPP;
 
 	mdelay(500);
 	ktz8866_reads(bd_a, 0x12, &pwm_reg_a.lbyte);
@@ -140,7 +154,8 @@ static int ktz8866_case2_test(int pwm, char *result)
 	u64 diff_b;
 
 	bl = pwm_to_51(pwm);
-	mi_mipi_dsi_dcs_set_pwm_value(bl);
+	if (ktz8866_set_panel_pwm(bl))
+		return -EOPNOTSUPP;
 
 	mdelay(128);
 
-- 
2.53.0

