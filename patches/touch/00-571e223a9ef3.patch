diff --git a/drivers/input/touchscreen/focaltech_spi/focaltech_esdcheck.c b/drivers/input/touchscreen/focaltech_spi/focaltech_esdcheck.c
new file mode 100644
index 000000000000..111eadb9a90a
--- /dev/null
+++ b/drivers/input/touchscreen/focaltech_spi/focaltech_esdcheck.c
@@ -0,0 +1,467 @@
+/*
+ *
+ * FocalTech TouchScreen driver.
+ *
