+static void fts_restore_normal_mode()
+{
+	int i;
+	for (i = 0; i < Touch_Report_Rate; i++) {
+		if (i != Touch_Panel_Orientation)
+			fts_restore_mode_value(i, GET_DEF_VALUE);
+	}
+}
