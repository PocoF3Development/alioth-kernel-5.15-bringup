diff --git a/drivers/input/touchscreen/focaltech_spi/Kconfig b/drivers/input/touchscreen/focaltech_spi/Kconfig
new file mode 100644
index 000000000000..799a70f71e3e
--- /dev/null
+++ b/drivers/input/touchscreen/focaltech_spi/Kconfig
@@ -0,0 +1,14 @@
+#
+# Focaltech Touchscreen driver configuration
+#
+
+config TOUCHSCREEN_FOCALTECH
+	tristate "Focaltech Touchscreen"
+	default n
+	help
+	  Say Y here if you have Focaltech touch panel.
+
+	  If unsure, say N.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called focaltech_touch.
