+static void str_space_remove(char *str)
+{
+	char *t = str;
+	char *s = str;
+
+	while (*t != '\0') {
+		if (*t != ' ') {
+			*s = *t;
+			s++;
+		}
+		t++;
+	}
+
+	*s = '\0';
+}
