+ */
+static int fts_test_entry(char *ini_file_name)
+{
+	int ret = 0;
+
+	/* test initialize */
+	ret = fts_test_main_init();
+	if (ret < 0) {
+		FTS_TEST_ERROR("fts_test_main_init fail");
