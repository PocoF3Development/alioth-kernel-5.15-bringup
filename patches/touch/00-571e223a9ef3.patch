+			if (ret < 0) {
+				FTS_TEST_DBG("basic thr:%s not found", name[i]);
+			} else {
+				FTS_TEST_DBG("basic thr:%s=%d", name[i], val[i]);
+			}
+		}
+	}
+
+	return 0;
+}
